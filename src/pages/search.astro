---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { readIndex } from '../lib/data';

const total = readIndex().length;
---

<Base
  title={`Search · ${SITE.name}`}
  description="Search trending, new and popular open-source release apps by name, description, language or topic."
>
  <div class="container">
    <section class="masthead">
      <h1>Search the shelf</h1>
      <p class="masthead__sub">
        Matches names, owners, descriptions, languages and topics across {total} projects in this data build.
      </p>
    </section>

    <form class="search" role="search" data-search-form>
      <label class="sr-only" for="q">Search apps</label>
      <input id="q" name="q" type="search" placeholder="notes, torrent, ssh, rust, privacy" autocomplete="off" spellcheck="false" />
      <button class="action" type="submit">Search</button>
    </form>
    <p class="search__hint" data-search-hint>Type at least two characters. Nothing is sent anywhere, the index is a static file.</p>

    <p class="status" data-search-status role="status" aria-live="polite"></p>
    <noscript><p class="status">Search runs in the browser and needs JavaScript. Browse the shelves without it.</p></noscript>
    <div class="ledger__head" aria-hidden="true">
      <span>#</span>
      <span>Project</span>
      <span>Platform</span>
      <span>Stars</span>
      <span>Installs</span>
      <span>Released</span>
    </div>
    <ol class="ledger" data-search-results></ol>
  </div>
</Base>

<script>
  interface SearchEntry {
    n: string;
    f: string;
    d: string;
    l: string;
    t: string[];
    s: number;
    dl: number;
    r: string;
    p: string;
  }

  const baseMeta = document.querySelector('meta[name="shelf-base"]') as HTMLMetaElement | null;
  const base = (baseMeta?.content ?? '/').replace(/\/$/, '');
  const input = document.getElementById('q') as HTMLInputElement | null;
  const status = document.querySelector('[data-search-status]') as HTMLElement | null;
  const results = document.querySelector('[data-search-results]') as HTMLOListElement | null;
  const hint = document.querySelector('[data-search-hint]') as HTMLElement | null;

  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });

  function clean(text: string): string {
    return text.replace(/[\u2014\u2013]/g, '-').replace(/\s+/g, ' ').trim();
  }

  let entries: SearchEntry[] | null = null;
  let loadError = false;

  async function index(): Promise<SearchEntry[]> {
    if (entries) return entries;
    const response = await fetch(`${base}/search-index.json`);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    entries = (await response.json()) as SearchEntry[];
    return entries;
  }

  function label(value: number): string {
    return value >= 1000 ? compact.format(value) : String(value);
  }

  function days(iso: string): number | null {
    if (!iso) return null;
    const parsed = Date.parse(iso);
    return Number.isNaN(parsed) ? null : Math.floor((Date.now() - parsed) / 86_400_000);
  }

  function releasedText(iso: string): string {
    const value = days(iso);
    if (value == null) return 'unknown';
    if (value <= 0) return 'today';
    if (value === 1) return 'yesterday';
    if (value < 30) return `${value}d ago`;
    if (value < 365) return `${Math.round(value / 30)}mo ago`;
    return `${Math.round(value / 365)}y ago`;
  }

  function row(entry: SearchEntry, position: number): HTMLLIElement {
    const [owner] = entry.f.split('/');
    const item = document.createElement('li');
    const anchor = document.createElement('a');
    anchor.className = 'row';
    anchor.href = `${base}/app/${entry.f}/`;

    const number = document.createElement('span');
    number.className = 'row__index mono';
    number.textContent = String(position + 1).padStart(2, '0');

    const main = document.createElement('span');
    main.className = 'row__main';

    const avatar = document.createElement('img');
    avatar.className = 'row__avatar';
    avatar.alt = '';
    avatar.width = 30;
    avatar.height = 30;
    avatar.loading = 'lazy';
    avatar.src = `https://github.com/${owner}.png?size=60`;

    const text = document.createElement('span');
    text.className = 'row__text';
    const title = document.createElement('span');
    title.className = 'row__title';
    const name = document.createElement('span');
    name.className = 'row__name';
    name.textContent = entry.n;
    const ownerNode = document.createElement('span');
    ownerNode.className = 'row__owner';
    ownerNode.textContent = owner;
    title.append(name, ownerNode);
    const desc = document.createElement('span');
    desc.className = 'row__desc';
    desc.textContent = entry.d ? clean(entry.d) : `Published by ${owner}`;
    text.append(title, desc);
    main.append(avatar, text);

    const ticks = document.createElement('span');
    ticks.className = 'row__ticks';
    for (const [index, letter] of ['A', 'W', 'M', 'L'].entries()) {
      const tick = document.createElement('span');
      const on = entry.p.includes(['a', 'w', 'm', 'l'][index]);
      tick.className = on ? 'tick tick--on' : 'tick';
      tick.textContent = letter;
      ticks.append(tick);
    }

    const stars = document.createElement('span');
    stars.className = 'row__stat row__stars';
    stars.textContent = label(entry.s);

    const installs = document.createElement('span');
    installs.className = 'row__stat row__installs';
    installs.textContent = label(entry.dl);

    const updated = document.createElement('span');
    updated.className = 'row__stat row__updated';
    updated.textContent = releasedText(entry.r);

    anchor.append(number, main, ticks, stars, installs, updated);
    item.append(anchor);
    return item;
  }

  function render(query: string): void {
    if (!status || !results) return;
    if (!entries) {
      status.textContent = loadError ? 'The search index could not be loaded.' : 'Loading the index.';
      return;
    }
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (tokens.length === 0) {
      results.replaceChildren();
      status.textContent = `${entries.length} projects in this build. Try "notes", "ssh" or "rust".`;
      return;
    }
    const matches = entries
      .filter((entry) => {
        const haystack = [entry.n, entry.f, entry.d, entry.l, entry.t.join(' ')].join(' ').toLowerCase();
        return tokens.every((token) => haystack.includes(token));
      })
      .sort((a, b) => b.s - a.s)
      .slice(0, 100);

    results.replaceChildren(...matches.map((entry, position) => row(entry, position)));
    status.textContent = matches.length
      ? `${matches.length} ${matches.length === 1 ? 'result' : 'results'} for "${query}".`
      : `Nothing matched "${query}". Try a shorter word or a topic like privacy.`;
    if (hint) hint.textContent = 'Results are ordered by stars. Every row links to the project page.';
  }

  let ready = false;

  async function boot(): Promise<void> {
    const initial = new URLSearchParams(location.search).get('q') ?? '';
    if (input) input.value = initial;
    try {
      await index();
      ready = true;
    } catch (error) {
      loadError = true;
    }
    render(initial);
  }

  let timer: number | undefined;
  input?.addEventListener('input', () => {
    if (!ready) return;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      const query = input.value.trim();
      history.replaceState(null, '', query ? `?q=${encodeURIComponent(query)}` : location.pathname);
      render(query);
    }, 120);
  });

  document.querySelector('[data-search-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!ready) return;
    const query = input?.value.trim() ?? '';
    history.replaceState(null, '', query ? `?q=${encodeURIComponent(query)}` : location.pathname);
    render(query);
  });

  void boot();
</script>
